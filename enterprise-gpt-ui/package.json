{
  "name": "enterprise-gpt-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run assets",
    "start": "ng serve",
    "prebuild": "npm run assets && npm run check:icons",
    "build": "ng build && node scripts/check-initial-chunk.mjs",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run assets",
    "test": "ng test",
    "pretest:ci": "npm run assets",
    "test:ci": "ng test --reporters=junit --reporters=default --output-file=test-results/ui.junit.xml",
    "test:watch": "ng test --watch",
    "pretest:a11y": "npm run assets",
    "test:a11y": "ng run enterprise-gpt-ui:test-a11y",
    "test:coverage": "ng test --coverage",
    "lint": "npm run lint:es && npm run check:icons && npm run check:forbidden && npm run check:tokens",
    "lint:es": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets": "npm run assets:fonts && npm run assets:icons && npm run assets:katex",
    "assets:fonts": "node scripts/copy-fonts.mjs",
    "assets:katex": "node scripts/copy-katex.mjs",
    "assets:icons": "node scripts/build-icon-sprite.mjs",
    "assets:brand": "node scripts/build-brand-images.mjs",
    "check:contract": "node scripts/check-andes-contract.mjs",
    "check:icons": "node scripts/check-icon-names.mjs",
    "check:forbidden": "node scripts/check-forbidden-apis.mjs",
    "check:tokens": "node scripts/check-tokens.mjs"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^24.0.0"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@azure/msal-angular": "^6.0.3",
    "@azure/msal-browser": "^5.18.0",
    "@microsoft/applicationinsights-web": "^3.4.3",
    "@ngrx/operators": "21.1.1",
    "@ngrx/signals": "21.1.1",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "dompurify": "^3.4.13",
    "katex": "^0.16.47",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "ngx-markdown": "^21.3.0",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@ngrx/eslint-plugin": "21.1.1",
    "@types/bootstrap": "^5.2.11",
    "@types/node": "^26.2.0",
    "@types/prismjs": "^1.26.6",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^21.4.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "jsdom": "^28.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.8.1",
    "sharp": "^0.35.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.0.8"
  }
}
