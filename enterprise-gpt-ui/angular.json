{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "enterprise-gpt-ui": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "changeDetection": "OnPush",
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["src/styles"],
              "sass": {
                "silenceDeprecations": ["import"]
              }
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "650kB",
                  "maximumError": "720kB"
                },
                {
                  "type": "bundle",
                  "name": "styles",
                  "maximumWarning": "65kB",
                  "maximumError": "80kB"
                },
                {
                  "type": "bundle",
                  "name": "ui-kit-routes",
                  "maximumWarning": "80kB",
                  "maximumError": "120kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "statsJson": true,
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": {
                  "inline": false
                }
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "enterprise-gpt-ui:build:production"
            },
            "development": {
              "buildTarget": "enterprise-gpt-ui:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "enterprise-gpt-ui:build:development",
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "watch": false,
            "providersFile": "src/testing/test-providers.ts",
            "setupFiles": ["src/testing/setup-dom.ts"]
          }
        }
      }
    }
  }
}
