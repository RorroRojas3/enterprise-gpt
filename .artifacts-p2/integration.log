            WHEN [c].[Status] = 3 THEN 1
        END) AS [FailedTurns], COUNT_BIG(CASE
            WHEN [c].[Kind] = 2 THEN 1
        END) AS [NamingTurns], COALESCE(SUM(CASE
            WHEN [c].[Kind] = 2 THEN [c].[InputTokens] + [c].[OutputTokens] + [c].[ToolInputTokens] + [c].[ToolOutputTokens]
