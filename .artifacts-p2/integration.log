        SELECT [c].[Status], [c].[Kind], COUNT_BIG(*) AS [Turns], COUNT_BIG(CASE
            WHEN [c].[Status] = 1 THEN 1
        END) AS [CompletedTurns], COUNT_BIG(CASE
            WHEN [c].[Status] = 2 THEN 1
