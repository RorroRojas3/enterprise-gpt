{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsOrigins": ["http://localhost:4200"],
  "OllamaUrl": "http://localhost:11434/",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=enterprise-gpt;Integrated Security=True;Encrypt=False;TrustServerCertificate=True"
  },
  "CosmosDb": {
    "ConnectionString": "AccountEndpoint=https://localhost:8081/;AccountKey=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==;",
    "DatabaseId": "enterprise-gpt",
    "ContainerId": "enterprise-gpt-container"
  },
  "BackgroundJobs": {
    "MaxConcurrent": 0,
    "RetentionMinutes": 60
  },
  "Documents": {
    "MaxFileSizeBytes": 52428800,
    "MaxQueuedBytes": 536870912,
    "EmbeddingBatchSize": 64,
    "DownloadUrlLifetimeMinutes": 5,
    "Chunking": {
      "MaxTokens": 512,
      "OverlapTokens": 128
    },
    "Retrieval": {
      "CandidateCount": 40,
      "LexicalCandidateCount": 40,
      "MaxResults": 8,
      "NeighborWindow": 1,
      "MaxDistance": 0.62,
      "MaxPassagesPerDocument": 3,
      "MaxResultTokens": 3000,
      "MaxQueryTerms": 8,
      "CommandTimeoutSeconds": 15,
      "EnableLexicalSearch": true
    }
  },
  "Mcp": {
    "Cache": {
      "TokenExpiryBuffer": "00:05:00",
      "MaxEntryLifetime": "00:30:00",
      "MinRemainingLifetimeForStream": "00:10:00",
      "ConnectionTimeout": "00:00:30",
      "SweepInterval": "00:05:00"
    }
  },
  "Permissions": {
    "Cache": {
      "EntryLifetime": "00:05:00"
    }
  },
  "RequestLogging": {
    "Enabled": true,
    "RequestStartLevel": "Information",
    "SlowRequestThreshold": "00:00:03",
    "RedactQueryValues": true,
    "IncludeUserAgent": true,
    "IncludeClientIp": false,
    "Bodies": {
      "LogRequestBody": false,
      "LogResponseBody": false,
      "LogLevel": "Information",
      "MaxBodyBytes": 4096
