  },
  "AmazonBedrock": {
    "Enabled": false,
    "Region": "us-east-1",
    "DefaultModelId": ""
  },
  "Anthropic": {
    "Enabled": false,
    "DefaultModelId": "claude-opus-5",
    "DefaultMaxOutputTokens": 32768,
    "Thinking": "adaptive",
    "Effort": "high"
  },
  "Tools": {
    "Weather": {
      "Enabled": true,
      "DelayMilliseconds": 600
    }
  }
}
