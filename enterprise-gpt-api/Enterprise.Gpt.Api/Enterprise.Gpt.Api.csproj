<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Enterprise.Gpt.Api</RootNamespace>
    <UserSecretsId>27ef94e5-8a02-48e5-b431-caa1880f8198</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Per-tool token tracking. The core package supplies UseToolTracking(), which Program.cs
         inserts ahead of UseFunctionInvocation() in every chat-client chain; the .Mcp and .Agent
         satellites supply the classifiers that turn an MCP tool or an agent-as-tool into something
         other than an anonymous function, and .UI supplies the serializable event contract the
         streaming endpoint writes. All four are referenced directly because Program.cs and
         ConversationEndpoints.cs use types from each. -->
    <PackageReference Include="Andes.Extensions.AI" Version="0.5.0" />
    <PackageReference Include="Andes.Extensions.AI.Agent" Version="0.5.0" />
    <PackageReference Include="Andes.Extensions.AI.Mcp" Version="0.5.0" />
    <PackageReference Include="Andes.Extensions.AI.UI" Version="0.5.0" />
    <!-- Anthropic first-party. Unlike Bedrock this needs a single package: the SDK carries the
         Microsoft.Extensions.AI bridge itself (IAnthropicClient.AsIChatClient), so there is no
         separate adapter to reference. -->
    <PackageReference Include="Anthropic" Version="12.40.0" />
    <!-- Amazon Bedrock. The MEAI package supplies IAmazonBedrockRuntime.AsIChatClient(), which wraps
         Converse/ConverseStream; BedrockRuntime itself is a direct dependency because Program.cs
         constructs AmazonBedrockRuntimeClient and its config to wire bearer-token auth. -->
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.101" />
    <PackageReference Include="AWSSDK.Extensions.Bedrock.MEAI" Version="4.0.101.7" />
    <PackageReference Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
    <PackageReference Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <!-- Application Insights. The OpenTelemetry distro rather than Microsoft.ApplicationInsights.AspNetCore:
         it is the current guidance for new ASP.NET Core apps, the two must not coexist, and only the
         distro exports the UseOpenTelemetry() spans the chat clients already emit. -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.62.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.8.3" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.3" />
    <PackageReference Include="Microsoft.Graph" Version="6.5.0" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <!-- Direct pin: Microsoft.AspNetCore.OpenApi 10.0.10 transitively brings 2.0.0, which has a known
         vulnerability (GHSA-v5pm-xwqc-g5wc / CVE-2026-49451, stack overflow on a circular schema
         reference). 2.7.5 is the first patched release on this line. Held on 2.x deliberately: 3.x
         made IOpenApiMediaType.Example read-only, and the XML-comment source generator that ships
         with Microsoft.AspNetCore.OpenApi 10.0.10 still assigns it, so a 3.x pin fails the build in
         generated code. Move both together when a matching AspNetCore.OpenApi is available. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Enterprise.Gpt.Dto\Enterprise.Gpt.Dto.csproj" />
    <ProjectReference Include="..\Enterprise.Gpt.Repository\Enterprise.Gpt.Repository.csproj" />
    <ProjectReference Include="..\Enterprise.Gpt.Service\Enterprise.Gpt.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the unit test project call the internal minimal-API handlers directly. -->
    <InternalsVisibleTo Include="Enterprise.Gpt.Unit.Test" />
  </ItemGroup>

</Project>
