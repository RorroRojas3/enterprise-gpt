<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Enterprise.Gpt.Api</RootNamespace>
    <UserSecretsId>27ef94e5-8a02-48e5-b431-caa1880f8198</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Per-tool token tracking. The core package supplies UseToolTracking(), which the provider
         configurations insert ahead of UseFunctionInvocation() in every chat-client chain; the .Mcp and .Agent
         satellites supply the classifiers that turn an MCP tool or an agent-as-tool into something
         other than an anonymous function, and .UI supplies the serializable event contract the
         streaming endpoint writes. All four are referenced directly because the provider
         configurations and ConversationEndpoints.cs use types from each. -->
    <PackageReference Include="Andes.Extensions.AI" />
    <PackageReference Include="Andes.Extensions.AI.Agent" />
    <PackageReference Include="Andes.Extensions.AI.Mcp" />
    <PackageReference Include="Andes.Extensions.AI.UI" />
    <!-- Anthropic first-party. Unlike Bedrock this needs a single package: the SDK carries the
         Microsoft.Extensions.AI bridge itself (IAnthropicClient.AsIChatClient), so there is no
         separate adapter to reference. -->
    <PackageReference Include="Anthropic" />
    <!-- Amazon Bedrock. The MEAI package supplies IAmazonBedrockRuntime.AsIChatClient(), which wraps
         Converse/ConverseStream; BedrockRuntime itself is a direct dependency because
         AmazonBedrockProviderConfiguration constructs AmazonBedrockRuntimeClient and its config to wire bearer-token auth. -->
    <PackageReference Include="AWSSDK.BedrockRuntime" />
    <PackageReference Include="AWSSDK.Extensions.Bedrock.MEAI" />
    <PackageReference Include="Azure.AI.DocumentIntelligence" />
    <!-- Wraps the Data Protection key ring with a vault key, so the database that stores the
         key ring is not on its own sufficient to decrypt the credentials it protects. -->
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" />
    <PackageReference Include="Azure.Identity" />
    <!-- Application Insights. The OpenTelemetry distro rather than Microsoft.ApplicationInsights.AspNetCore:
         it is the current guidance for new ASP.NET Core apps, the two must not coexist, and only the
         distro exports the UseOpenTelemetry() spans the chat clients already emit. -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <!-- Direct rather than transitive through the configuration-secrets package above: the Key
         Vault registration builds SecretClient and SecretClientOptions by hand, to set the retry
         policy a startup-blocking read needs. -->
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Azure.Cosmos" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Graph" />
    <PackageReference Include="Microsoft.Identity.Web" />
    <!-- Security pin over the transitive version; see Directory.Packages.props. -->
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Newtonsoft.Json" />
    <!-- Direct rather than transitive through Microsoft.Extensions.AI.OpenAI: AzureOpenAIProviderConfiguration and
         AzureOpenAIDefaults construct OpenAIClient and the OpenAI.Responses request
         types by hand. Its version is a ceiling; see Directory.Packages.props. -->
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Enterprise.Gpt.Common\Enterprise.Gpt.Common.csproj" />
    <ProjectReference Include="..\Enterprise.Gpt.Dto\Enterprise.Gpt.Dto.csproj" />
    <ProjectReference Include="..\Enterprise.Gpt.Entity\Enterprise.Gpt.Entity.csproj" />
    <ProjectReference Include="..\Enterprise.Gpt.Repository\Enterprise.Gpt.Repository.csproj" />
    <ProjectReference Include="..\Enterprise.Gpt.Service\Enterprise.Gpt.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the unit test project call the internal minimal-API handlers directly. -->
    <InternalsVisibleTo Include="Enterprise.Gpt.Unit.Test" />
  </ItemGroup>

</Project>
