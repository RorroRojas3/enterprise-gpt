<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Enterprise.Gpt.Unit.Test</RootNamespace>
    <!-- xUnit v3 test projects build as executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- SQLite in-memory backs ModelService tests: unlike the EF InMemory provider it
         supports the relational ExecuteUpdateAsync used by DeactivateModelAsync. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.9.0" />
    <!-- Overrides the transitive 2.1.11 native bundle, which has a known vulnerability
         (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Enterprise.Gpt.Api\Enterprise.Gpt.Api.csproj" />
    <ProjectReference Include="..\..\Enterprise.Gpt.Service\Enterprise.Gpt.Service.csproj" />
    <ProjectReference Include="..\..\Enterprise.Gpt.Repository\Enterprise.Gpt.Repository.csproj" />
    <ProjectReference Include="..\..\Enterprise.Gpt.Dto\Enterprise.Gpt.Dto.csproj" />
    <ProjectReference Include="..\..\Enterprise.Gpt.Entity\Enterprise.Gpt.Entity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real shipped configuration, so a test that checks the committed values binds the file
         instead of a copy of it. A hand-maintained duplicate would pass while the host refused to
         start, which is the exact failure the test exists to catch. Linked flat and renamed, so it
         cannot be mistaken for this test project's own settings. -->
    <None Include="..\..\Enterprise.Gpt.Api\appsettings.json"
          Link="api-appsettings.json"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The published File Agent capability document, so ConversionMatrixDocumentTests can hold
         its rendered table against the JSON it is rendered from. Linked rather than duplicated for
         the same reason as the settings file above: a hand-maintained copy would pass while the
         document a reader actually opens said something else. -->
    <None Include="..\..\..\docs\file-agent\sandbox-capabilities.md"
          Link="file-agent-sandbox-capabilities.md"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
