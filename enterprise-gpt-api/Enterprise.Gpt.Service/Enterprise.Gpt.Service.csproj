<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Enterprise.Gpt.Service</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Andes.Extensions.AI" />
    <!-- Agent-as-tool tracking for the File Agent. -->
    <PackageReference Include="Andes.Extensions.AI.Agent" />
    <!-- McpClientTool.WithTracking(string serverName) in McpToolProvider: without it a leased MCP
         tool classifies as an anonymous function and its usage lands with no server attribution. -->
    <PackageReference Include="Andes.Extensions.AI.Mcp" />
    <!-- The streamed event contract ConversationService projects a turn into. -->
    <PackageReference Include="Andes.Extensions.AI.UI" />
    <PackageReference Include="Azure.AI.DocumentIntelligence" />
    <!-- CSV (.csv) text extraction — see Documents/Extraction/CsvTextExtractor.cs. A correct RFC 4180 reader has to
         handle quoted multi-line fields, escaped quotes and ragged rows, and getting any of those wrong
         corrupts cell data silently; MS-PL/Apache-2.0 and no dependencies of its own on net8.0+. -->
    <PackageReference Include="CsvHelper" />
    <!-- Legacy Word (.doc) to .docx conversion — see Documents/Extraction/DocSharpLegacyWordConverter.cs. Azure
         Document Intelligence accepts .docx but not the binary .doc format, so .doc is converted first and
         then follows the same OCR path as every other Word document. -->
    <PackageReference Include="DocSharp.Binary.Doc" />
    <!-- PowerPoint (.pptx) and Excel (.xlsx) text extraction — see Documents/Extraction/PresentationTextExtractor.cs
         and Documents/Extraction/SpreadsheetTextExtractor.cs. -->
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Markdig" />
    <!-- The File Agent runs as a Microsoft Agent Framework agent; see Agents/FileAgentToolProvider.cs. -->
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Azure.Cosmos" />
    <!-- Abstractions only: this project consumes IDataProtectionProvider, while the key ring
         and its Key Vault wrapping are configured in the host. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" />
    <!-- Security pin over the version Microsoft.ML.Tokenizers brings; see Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Bcl.Memory" />
    <!-- Referenced directly, not left transitive through Enterprise.Gpt.Entity: document retrieval binds
         SqlParameter and SqlVector<float> by hand — see Documents/Retrieval/DocumentRetrievalService.cs. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Graph" />
    <PackageReference Include="Microsoft.Identity.Web" />
    <!-- Token-accurate RAG chunking — see Documents/Chunking/TokenTextChunker.cs. The Data package carries the
         cl100k_base vocabulary used by the text-embedding-3-* and ada-002 embedding models. -->
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Newtonsoft.Json" />
    <!-- PDF conversation export — see Exports/Renderers/PdfExportRenderer.cs. The cross-platform (Core)
         build, so it carries no Windows dependency and resolves no font of its own; Exports/Fonts/
         ExportFontResolver.cs is what supplies faces. MIT, which is why this and not QuestPDF, whose
         Community tier is source-available rather than MIT and is gated on company revenue. -->
    <PackageReference Include="PDFsharp-MigraDoc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Enterprise.Gpt.Dto\Enterprise.Gpt.Dto.csproj" />
    <ProjectReference Include="..\Enterprise.Gpt.Repository\Enterprise.Gpt.Repository.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ConversationLockService.ActiveLockCount is exposed to the unit tests so they can assert
         that the lock registry drains rather than leaks entries. -->
    <InternalsVisibleTo Include="Enterprise.Gpt.Unit.Test" />
  </ItemGroup>

  <ItemGroup>
    <!-- ExportFontResolver probes {BaseDirectory}/Fonts, so the five role-named faces committed under
         Exports/Fonts have to land there; Link flattens the folder. A glob rather than five entries,
         because Exports/Fonts/README.md documents dropping a re-branded set in as a file copy. -->
    <None Include="Exports\Fonts\*.ttf;Exports\Fonts\*.otf;Exports\Fonts\*.ttc"
          Link="Fonts\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Shipped rather than embedded so an operator can read it. The document-conversion skill and
         FileAgentOptions both load this one file, so a pair cannot be refused in one place and offered
         in another. -->
    <None Update="Agents\Documents\conversion-matrix.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- Read from {BaseDirectory}/Files; Link keeps that output path. -->
    <None Update="Exports\Templates\conversation-history.html"
          Link="Files\conversation-history.html"
          CopyToOutputDirectory="Always" />
    <None Update="Prompts\conversation-default-system-prompt.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Prompts\conversation-naming-prompt.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Prompts\document-retrieval-prompt.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Prompts\project-instructions-prompt.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Prompts\document-summary-tool-prompt.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Prompts\document-summary-single-pass-prompt.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Prompts\document-summary-map-prompt.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Prompts\document-summary-reduce-prompt.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Prompts\document-summary-collapse-prompt.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Prompts\document-summary-digest-prompt.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Prompts\sheet-query-tool-prompt.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Prompts\file-agent-instructions.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- Globbed, unlike the prompts above: a skill is a directory of files rather than one
         named template, and the startup probe fails the deploy when the set that shipped is
         not the set the agent expects. -->
    <None Update="Agents\Documents\Skills\**\*.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
