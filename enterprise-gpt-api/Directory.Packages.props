<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Andes.Extensions.AI" Version="0.8.0" />
    <PackageVersion Include="Andes.Extensions.AI.Agent" Version="0.8.0" />
    <PackageVersion Include="Andes.Extensions.AI.Mcp" Version="0.8.0" />
    <PackageVersion Include="Andes.Extensions.AI.UI" Version="0.8.0" />
    <PackageVersion Include="Anthropic" Version="12.40.0" />
    <PackageVersion Include="AWSSDK.BedrockRuntime" Version="4.0.101.1" />
    <PackageVersion Include="AWSSDK.Extensions.Bedrock.MEAI" Version="4.0.101.8" />
    <PackageVersion Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.4" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="DocSharp.Binary.Doc" Version="0.21.0" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.17.0" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.62.1" />
    <!-- Direct pin: Microsoft.ML.Tokenizers 2.0.0 transitively brings 9.0.4, which has a known
         vulnerability (GHSA-73j8-2gch-69rq). -->
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.11" />
    <!-- Entity pins this for the vector(1536) column; Service binds SqlParameter and SqlVector<float>
         by hand. One version keeps the two in step. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Graph" Version="6.5.0" />
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
    <!-- Direct pin: Microsoft.AspNetCore.OpenApi 10.0.11 transitively brings 2.0.0, which has a known
         vulnerability (GHSA-v5pm-xwqc-g5wc / CVE-2026-49451, stack overflow on a circular schema
         reference). Held on 2.x: AspNetCore.OpenApi 10.0.11 constrains it to [2.7.5, 3.0.0), and its
         XML-comment source generator still assigns the IOpenApiMediaType.Example that 3.x made
         read-only. Move both together when a matching AspNetCore.OpenApi is available. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <!-- Ceiling, not a floor: Microsoft.Extensions.AI.OpenAI 10.9.0 declares OpenAI [2.12.0, 2.13.0),
         so pinning 2.13.0 produces NU1608. Raise this only when that adapter widens its range. -->
    <PackageVersion Include="OpenAI" Version="2.12.0" />
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.20" />
    <!-- Overrides the transitive 2.1.11 native bundle, which has a known vulnerability
         (GHSA-2m69-gcr7-jv3q). -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- Overrides the transitive 2025.1.0 that Testcontainers 4.13.0 brings (GHSA-q939-rpr3-3284 /
         CVE-2026-48798, arbitrary file write from a hostile SCP server during a recursive download).
         Safe because Testcontainers declares a floor, not an exact pin, and uses SSH.NET only for its
         port-forwarding container — a path these tests never take. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- Direct pins: Microsoft.Data.SqlClient 7.0.2 brings Pkcs 9.0.13, and
         Microsoft.AspNetCore.DataProtection 10.0.11 brings Xml (and through it Pkcs) 10.0.11, all
         with known vulnerabilities (Pkcs: GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx; Xml:
         GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj, GHSA-r955-8q5j-3h83). Drop them once those
         packages require 10.0.13 themselves. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.13.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

</Project>
