<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Enterprise.Gpt.Repository</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Data Protection key ring lives in this database rather than in blob storage: the app
         already owns a migration pipeline for it, and a key ring the deployment cannot lose in a
         slot swap is what keeps stored user credentials readable. Key Vault wraps it in
         Program.cs, so the database alone never decrypts them. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Azure.Cosmos" />
    <!-- Required by Microsoft.Azure.Cosmos's build check even though the store serializes with
         System.Text.Json. -->
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Enterprise.Gpt.Entity\Enterprise.Gpt.Entity.csproj" />
  </ItemGroup>

</Project>
